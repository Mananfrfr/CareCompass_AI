# Copy to .env (or run: python scripts/run_agents.py --init-env). Never commit .env.

# --- ASI1 LLM (https://asi1.ai/dashboard/api-keys). Optional: without it CareCompass uses its rule-based parser.
ASI1_API_KEY=
ASI1_BASE_URL=https://api.asi1.ai/v1
ASI1_MODEL=asi1

# --- Data mode
#   live    (recommended): real public data for every Indian city - National Health Portal hospital directory
#           (~30k facilities), state government catalogs, OpenStreetMap via Overpass, IRDAI product register
#           and official policy wordings.
#   fixture: synthetic, clearly labelled demo data for Jaipur/Delhi/Ajmer; the real directory everywhere else.
CARECOMPASS_DATA_MODE=live

# --- Agent identities. Keep secret; changing a seed changes the agent address.
COORDINATOR_SEED=
HOSPITAL_AGENT_SEED=
INSURER_AGENT_SEED=

# --- Networking
COORDINATOR_CONNECTIVITY=mailbox   # mailbox (Agentverse/ASI:One) | local (localhost testing)
COORDINATOR_PORT=8000
HOSPITAL_AGENT_PORT=8001
INSURER_AGENT_PORT=8002

# --- Storage (SQLite MVP; any SQLAlchemy URL works, e.g. postgresql+psycopg://...)
# DATABASE_URL=sqlite:///data/carecompass.db

# --- Reliability
RESEARCH_TIMEOUT_S=45
RESEARCH_MAX_ATTEMPTS=2
ACTION_MAX_ATTEMPTS=3

# --- Outbound HTTP identity for live mode (Nominatim policy requires a contact)
HTTP_USER_AGENT=CareCompassAI/0.2 (+https://github.com/Mananfrfr/CareCompass_AI)
# Optional Payment Protocol sandbox. Disabled by default; live keys are rejected.
CARECOMPASS_PAYMENTS=disabled
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
